# Copy this file to .env and fill in your local file paths
# DO NOT commit .env - it contains local system paths

# VPCM plume simulations (96x96x78 and 96x96x50 grids)
EQDAY_PLUME=/path/to/Xins_eq_day.nc
EQNIGHT_PLUME=/path/to/Xins_eq_night.nc
SO2_PLUME=/path/to/Xins_so2.nc
SO2_PLUME_BIG=/path/to/Xins_so2_big.nc
CHEM_PLUME=/path/to/Xins_chem.nc
HOTSPOT1_PLUME=/path/to/Xins_hotspot1.nc
HOTSPOT2_PLUME=/path/to/Xins_hotspot2.nc
PILLAR_PLUME=/path/to/Xins_pillar.nc

# SPICAV SO2 retrievals
RETRIEVALS=/path/to/SO2_lons.nc

# Figure output
SAVEDIR=/path/to/save/figures/
FILETYPE=png

# Output directory for open data repository extracts
DATA_OUT=/path/to/data/extracts/
